{
    "injectionSelector": "L:text.html.markdown -string -meta.embedded -markup.inline.raw -markup.fenced_code",
    "patterns": [
        { "include": "#citation_list" },
        { "include": "#cross_reference" },
        { "include": "#cross_reference_in_citation" },
        { "include": "#cross_reference_bare" },
        { "include": "#footnote_ref" },
        { "include": "#footnote_def" },
        { "include": "#colored_format_highlight" },
        { "include": "#format_highlight" },
        { "include": "#escaped_brace" },
        { "include": "#addition" },
        { "include": "#deletion" },
        { "include": "#substitution" },
        { "include": "#highlight" },
        { "include": "#comment_with_id" },
        { "include": "#comment" },
        { "include": "#comment_range_start" },
        { "include": "#comment_range_end" },
        { "include": "#trailing_backslash_break" }
    ],
	"repository": {
		"addition": {
			"begin": "\\{\\+\\+",
			"end": "\\+\\+\\}",
			"name": "markup.inserted.manuscript-markdown",
			"contentName": "markup.inserted"
		},
		"deletion": {
			"begin": "\\{--",
			"end": "--\\}",
			"name": "markup.deleted.manuscript-markdown",
			"contentName": "markup.deleted"
		},
		"substitution": {
			"begin": "\\{\\~\\~",
			"end": "\\~\\~\\}",
			"name": "markup.changed.manuscript-markdown",
			"contentName": "markup.deleted",
			"patterns": [
				{
					"begin": "~>",
					"beginCaptures": { "0": { "name": "punctuation.separator.manuscript-markdown" } },
					"end": "(?=~~\\})",
					"contentName": "markup.inserted"
				}
			]
		},
		"comment_with_id": {
			"begin": "(\\{#)([a-zA-Z0-9_-]++)(>>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.manuscript-markdown" },
				"2": { "name": "entity.name.tag.manuscript-markdown" },
				"3": { "name": "punctuation.definition.tag.begin.manuscript-markdown" }
			},
			"end": "<<\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.tag.end.manuscript-markdown" }
			},
			"contentName": "meta.comment.manuscript-markdown"
		},
		"comment": {
			"begin": "(\\{)(>>)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.manuscript-markdown" },
				"2": { "name": "punctuation.definition.tag.begin.manuscript-markdown" }
			},
			"end": "(<<)(\\})",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.manuscript-markdown" },
				"2": { "name": "punctuation.definition.tag.end.manuscript-markdown" }
			},
			"name": "meta.comment.manuscript-markdown",
			"contentName": "meta.comment"
		},
		"comment_range_start": {
			"match": "(\\{#)(?!(?:fig|tbl)-[a-zA-Z0-9_-])([a-zA-Z0-9_-]++)(\\})",
			"captures": {
				"1": { "name": "punctuation.definition.tag.begin.manuscript-markdown" },
				"2": { "name": "entity.name.tag.manuscript-markdown" },
				"3": { "name": "punctuation.definition.tag.end.manuscript-markdown" }
			}
		},
		"comment_range_end": {
			"match": "(\\{/)([a-zA-Z0-9_-]++)(\\})",
			"captures": {
				"1": { "name": "punctuation.definition.tag.begin.manuscript-markdown" },
				"2": { "name": "entity.name.tag.manuscript-markdown" },
				"3": { "name": "punctuation.definition.tag.end.manuscript-markdown" }
			}
		},
		"highlight": {
			"begin": "(\\{)(==)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.tag.begin.manuscript-markdown" },
				"2": { "name": "punctuation.definition.tag.begin.manuscript-markdown" }
			},
			"end": "(==)(\\})",
			"endCaptures": {
				"1": { "name": "punctuation.definition.tag.end.manuscript-markdown" },
				"2": { "name": "punctuation.definition.tag.end.manuscript-markdown" }
			},
			"name": "markup.bold.manuscript-markdown",
			"contentName": "markup.bold"
		},
		"colored_format_highlight": {
			"comment": "Its text as format_highlight's",
			"match": "(?<!\\\\)((?:\\\\\\\\)*+(?:\\\\\\{|(?<![{=])))(==((?:\\\\(?:[^}=]|(?==))|\\{(?!=)|[^}=\\\\{])++)==\\{([a-z0-9](?:[a-z0-9-]*[a-z0-9])?)\\})",
			"captures": {
				"1": { "name": "constant.character.escape.manuscript-markdown" },
				"2": { "name": "markup.highlight.colored.manuscript-markdown" },
				"3": { "name": "markup.highlight" },
				"4": { "name": "entity.other.attribute-name.manuscript-markdown" }
			}
		},
		"format_highlight": {
			"comment": "An == after an odd run of backslashes, or right after a { or an =, opens none, but one right after an escaped { does: the first capture takes the run and that escaped { (see combinedPattern in src/changes.ts). Its text reads a backslash and the character after it as one, so a { at its end is escaped only after an odd run. An unescaped { ends no text: the == after it is a {=='s, which closes no format highlight to export, the preview or the decorations",
			"match": "(?<!\\\\)((?:\\\\\\\\)*+(?:\\\\\\{|(?<![{=])))(==((?:\\\\(?:[^}=]|(?==))|\\{(?!=)|[^}=\\\\{])++)==(?![}=]))",
			"captures": {
				"1": { "name": "constant.character.escape.manuscript-markdown" },
				"2": { "name": "markup.highlight.manuscript-markdown" },
				"3": { "name": "markup.highlight" }
			}
		},
		"footnote_ref": {
			"match": "(\\[\\^)([a-zA-Z0-9_-]++)(\\])(?!:)",
			"captures": {
				"1": { "name": "punctuation.definition.footnote.begin.manuscript-markdown" },
				"2": { "name": "entity.name.footnote.manuscript-markdown" },
				"3": { "name": "punctuation.definition.footnote.end.manuscript-markdown" }
			}
		},
		"footnote_def": {
			"match": "^(\\[\\^)([a-zA-Z0-9_-]++)(\\]:)",
			"captures": {
				"1": { "name": "punctuation.definition.footnote.begin.manuscript-markdown" },
				"2": { "name": "entity.name.footnote.manuscript-markdown" },
				"3": { "name": "punctuation.definition.footnote.end.manuscript-markdown" }
			}
		},
		"trailing_backslash_break": {
			"match": "\\\\$",
			"name": "constant.character.escape.manuscript-markdown"
		},
		"escaped_brace": {
			"match": "(?<!\\\\)(?:\\\\\\\\)*+\\\\\\{",
			"name": "constant.character.escape.manuscript-markdown"
		},
		"cross_reference": {
			"comment": "A cross-reference to a figure or a table, as export reads one (see crossRefAt in src/citation-syntax.ts): its key alone in a citation's brackets, as [@fig-map], not after a backslash, which escapes the [",
			"match": "(?<!\\\\)(\\[)(@)((?:[Ff]ig|[Tt]bl)-[^\\s,;\\]@`\\[]+)(\\])",
			"name": "meta.cross-reference.manuscript-markdown",
			"captures": {
				"1": {"name": "punctuation.definition.brackets.begin.manuscript-markdown"},
				"2": {"name": "support.function.cross-reference.manuscript-markdown"},
				"3": {"name": "support.function.cross-reference.manuscript-markdown"},
				"4": {"name": "punctuation.definition.brackets.end.manuscript-markdown"}
			}
		},
		"cross_reference_in_citation": {
			"comment": "A citation's brackets with a cross-reference's key in them among other text, as [-@fig-map] or [see @fig-map], which citation_list begins none of and export reads as text",
			"match": "(?<!\\\\)\\[(?=\\s*-?@|(?:[^\\[\\];`\\\\]|\\\\[^\\[\\];])*\\s-?@[\\p{L}\\p{N}_](?![^\\[\\]]*\\][(\\[]))(?=[^\\]]*?(?<![^\\s;\\[])-?@(?:[Ff]ig|[Tt]bl)-[^\\s,;\\]])[^\\]]*\\]",
			"name": "meta.cross-reference.text.manuscript-markdown"
		},
		"cross_reference_bare": {
			"comment": "A bare @ and a cross-reference's key, as Pandoc reads one, after none of a letter, a digit, _ . - / @ a backtick or a backslash, and not in a link's text",
			"match": "(?<![\\p{L}\\p{N}_.\\-/@`\\\\])(@)((?:[Ff]ig|[Tt]bl)-[\\p{L}\\p{N}_](?:[\\p{L}\\p{N}_]|[:.#$%&\\-+?<>~/](?=[\\p{L}\\p{N}_]))*)(?![^\\[\\]]*\\][(\\[])",
			"name": "meta.cross-reference.manuscript-markdown",
			"captures": {
				"1": {"name": "support.function.cross-reference.manuscript-markdown"},
				"2": {"name": "support.function.cross-reference.manuscript-markdown"}
			}
		},
		"citation_list": {
			"comment": "Not one with a cross-reference's key in it, as [@fig-map] or [see @fig-map], which export reads as no citation (see crossRefAt in src/citation-syntax.ts)",
			"begin": "\\[(?![^\\[\\]]*?(?<![^\\s;\\[])-?@(?:[Ff]ig|[Tt]bl)-[^\\s,;\\]])(?=\\s*-?@|(?:[^\\[\\];`\\\\]|\\\\[^\\[\\];])*\\s-?@[\\p{L}\\p{N}_](?![^\\[\\]]*\\][(\\[]))",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.brackets.begin.manuscript-markdown" }
			},
			"end": "\\]",
			"endCaptures": {
				"0": { "name": "punctuation.definition.brackets.end.manuscript-markdown" }
			},
			"name": "meta.citation.manuscript-markdown",
			"patterns": [
				{
					"comment": "A key as export reads it (see readCitationItem in src/citation-syntax.ts): after the first @ or -@ at its item's start or after a space, past spaces, to its item's comma, without the spaces at its end. An item starts right after the citation's [, where \\G matches, as the begin pattern's match ends there, after a ;, or at a line's start, but not after another [, which is text in an item",
					"match": "(?:\\G|^|(?<=;))(?:[^;\\]]*?(?<=\\s))??(-?)(@)\\s*([^,;\\]\\s](?:[^,;\\]]*[^,;\\]\\s])?)?",
					"captures": {
						"2": { "name": "support.function.citation.manuscript-markdown" },
						"3": { "name": "support.function.citation.manuscript-markdown" }
					}
				},
				{
					"match": ";",
					"name": "punctuation.separator.sequence.manuscript-markdown"
				}
			]
		}
	},
    "scopeName": "manuscript-markdown.injection"
}