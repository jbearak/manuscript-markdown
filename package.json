    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets.json"
      }
    ],
    "languages": [
      {
        "id": "markdown",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/manuscript-markdown.json",
        "scopeName": "manuscript-markdown.injection",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "markdown.previewStyles": [
      "./media/manuscript-markdown.css"
    ],
    "markdown.previewScripts": [
      "./media/manuscript-markdown-preview.js"
    ],
    "markdown.markdownItPlugins": true,
    "configurationDefaults": {
      "[markdown]": {
        "editor.wordWrap": "on"
      },
      "[bibtex]": {
        "editor.wordWrap": "on"
      }
    },
    "configuration": {
      "title": "Manuscript Markdown",
      "properties": {
        "manuscriptMarkdown.includeAuthorNameInComments": {
          "type": "boolean",
          "default": true,
          "description": "Include author name in comment attribution"
        },
        "manuscriptMarkdown.authorName": {
          "type": "string",
          "default": "",
          "description": "Author name to use in comments (leave empty to use OS username)"
        },
        "manuscriptMarkdown.includeTimestampInComments": {
          "type": "boolean",
          "default": true,
          "description": "Include timestamp in comment author attribution (format: username (yyyy-mm-dd hh:mm))"
        },
        "manuscriptMarkdown.enableCitekeyLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable language server features: YAML frontmatter completions, hover, and diagnostics; @ completions; citation go-to-definition and references; and comment hover."
        },
        "manuscriptMarkdown.defaultHighlightColor": {
          "type": "string",
          "enum": [
            "yellow",
            "green",
            "turquoise",
            "pink",
            "blue",
            "red",
            "dark-blue",
            "teal",
            "violet",
            "dark-red",
            "dark-yellow",
            "gray-50",
            "gray-25",
            "black"
          ],
          "default": "yellow",
          "description": "Default background color for ==highlight== formatting when no color is specified"
        },
        "manuscriptMarkdown.tableIndent": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "description": "Number of spaces per indent level for HTML tables in DOCX to Markdown conversion"
        },
        "manuscriptMarkdown.pipeTableMaxLineWidth": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "description": "Maximum line width for pipe tables in DOCX→MD conversion. Tables exceeding this width, or containing colspans/rowspans/line breaks, fall back to grid tables then HTML. Set to 0 to skip pipe tables."
        },
        "manuscriptMarkdown.gridTableMaxLineWidth": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "description": "Maximum line width for grid tables in DOCX→MD conversion. Tables exceeding this width fall back to HTML. Set to 0 to always skip grid table format."
        },
        "manuscriptMarkdown.citationKeyFormat": {
          "type": "string",
          "enum": [
            "authorYearTitle",
            "authorYear",
            "numeric"
          ],
          "default": "authorYearTitle",
          "enumDescriptions": [
            "Author surname + year + first title word (e.g., smith2020effects)",
            "Author surname + year (e.g., smith2020)",
            "Sequential numbers (e.g., 1, 2, 3)"
          ],
          "description": "Citation key format for DOCX to Markdown conversion"
        },
        "manuscriptMarkdown.blockquoteStyle": {
          "type": "string",
          "enum": [
            "Quote",
            "IntenseQuote",
            "GitHub"
          ],
          "default": "GitHub",
          "description": "Word paragraph style to use for blockquotes when converting Markdown to DOCX"
        },
        "manuscriptMarkdown.colors": {
          "type": "string",
          "enum": [
            "github",
            "guttmacher"
          ],
          "enumItemLabels": [
            "GitHub",
            "Guttmacher"
          ],
          "default": "guttmacher",
          "description": "Color scheme for alert callouts in preview and DOCX export"
        },
        "manuscriptMarkdown.alwaysUseCommentIds": {
          "type": "boolean",
          "default": false,
          "description": "Always use ID-based comment syntax ({#id}...{/id}{#id>>...<<}) even for non-overlapping comments during DOCX to Markdown conversion"
        },
        "manuscriptMarkdown.citekeyReferencesFromMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "Include markdown usages in Find All References when invoked from a markdown file. Off by default because VS Code's built-in Markdown Language Features extension already reports these; enabling this may produce duplicate entries."
        },
        "manuscriptMarkdown.embedDtaMaxFileSize": {
          "type": "integer",
          "default": 10485760,
          "minimum": 1,
          "description": "Maximum .dta file size in bytes for embed directives. Files larger than this are rejected with an error. Default: 10 MB (10485760 bytes)."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src/ --max-warnings 0",
    "compile": "node esbuild.mjs && bun run copy-csl",
    "copy-csl": "rm -rf out/csl-styles out/csl-locales && cp -R src/csl-styles out/csl-styles && cp -R src/csl-locales out/csl-locales",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:word-dirty": "WORD_TESTS=1 bun test src/word-dirty.test.ts",
    "word:dirty": "bun scripts/dirty-flag-diagnose.ts",
    "clean": "rm -rf out/",
    "rebuild": "bun run clean && bun run compile",
    "package": "bun run rebuild && bunx vsce package --no-dependencies",
    "build:binary": "bun scripts/build-binary.ts binary",
    "build:current": "bun scripts/build-binary.ts current",
    "install-local": "bun run package && code --install-extension manuscript-markdown-$(node -p \"require('./package.json').version\").vsix --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^2.2.42",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.103.2",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "private": true,
  "dependencies": {
    "@jbearak/dta-parser": "^0.1.1",
    "citeproc": "^2.4.63",
    "fast-xml-parser": "^5.5.7",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "@e965/xlsx": "^0.20.3"
  }
}
